# Ollama backend
OLLAMA_BASE_URL=http://localhost:11434

# Where this proxy listens
LISTEN_HOST=0.0.0.0
LISTEN_PORT=11433

# The only credential allowed to create / list / delete client keys.
# Leave it empty and one is generated on first start, persisted in KEYS_FILE with
# mode 0600, and reused on every restart.
ADMIN_API_KEY=

# Where the allow-list and the generated admin key are stored.
KEYS_FILE=api_keys.json

# Seconds to wait on the Ollama backend.
REQUEST_TIMEOUT=300
